#!/usr/bin/env python3
"""
scan_restamper — Re-sella LaserScan con el reloj del PC y corrige el frame_id.

Publica siempre a /scan_stamped para evitar conflictos cuando el LiDAR
ya publica en /scan. El slam_node y obstacle_avoidance suscriben /scan_stamped.

Parámetros:
  input_topic  — topic raw de la Jetson (default: /scan)
  target_frame — frame_id destino en el mensaje (default: lidar_link)
  invert_angles — invierte izquierda/derecha cuando el driver o montaje del
                  LiDAR publica los ángulos espejeados.
  angle_offset_rad — rota todos los rayos del scan en radianes. Usa 3.14159
                     cuando frente/atrás están invertidos.
"""

import rclpy
from rclpy.node import Node
from rclpy.qos import (
    DurabilityPolicy,
    HistoryPolicy,
    QoSProfile,
    ReliabilityPolicy,
    qos_profile_sensor_data,
)
from sensor_msgs.msg import LaserScan


class ScanRestamper(Node):
    def __init__(self):
        super().__init__('scan_restamper')

        self.declare_parameter('input_topic',  '/scan')
        self.declare_parameter('target_frame', 'lidar_link')
        self.declare_parameter('invert_angles', False)
        self.declare_parameter('angle_offset_rad', 0.0)

        in_topic     = self.get_parameter('input_topic').value
        self.frame   = self.get_parameter('target_frame').value
        self.invert_angles = self.get_parameter('invert_angles').value
        self.angle_offset = float(self.get_parameter('angle_offset_rad').value)

        # QoS de sensor: BEST_EFFORT + KEEP_LAST depth=1 → siempre entrega el scan
        # MÁS RECIENTE y descarta los viejos (sin cola que acumule latencia).
        # Esencial para detección reactiva de obstáculos: el robot reacciona al
        # último scan, no a uno encolado de hace varios ciclos.
        # NOTA: en RViz pon el LaserScan display con Reliability Policy = "Best Effort".
        output_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
        )
        self.pub = self.create_publisher(LaserScan, '/scan_stamped', output_qos)
        self.sub = self.create_subscription(
            LaserScan, in_topic, self._cb, qos_profile_sensor_data)

        self.get_logger().info(
            f'scan_restamper: {in_topic} → /scan_stamped  '
            f'frame_id={self.frame}  invert_angles={self.invert_angles}  '
            f'angle_offset_rad={self.angle_offset:.3f}')

    def _cb(self, msg: LaserScan):
        msg.header.stamp    = self.get_clock().now().to_msg()
        msg.header.frame_id = self.frame
        if self.invert_angles:
            msg.ranges = list(reversed(msg.ranges))
            msg.intensities = list(reversed(msg.intensities))
            old_min = msg.angle_min
            old_max = msg.angle_max
            msg.angle_min = -old_max
            msg.angle_max = -old_min
        if self.angle_offset != 0.0:
            msg.angle_min += self.angle_offset
            msg.angle_max += self.angle_offset
        self.pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = ScanRestamper()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
