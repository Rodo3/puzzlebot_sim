#!/usr/bin/env python3
"""Publish map -> odom from absolute ArUco robot poses.

Wheel odometry owns the continuous odom -> base_footprint transform. ArUco
measurements are absolute robot poses in map. This node converts each absolute
measurement into the global correction:

    T_map_odom = T_map_base_measured * inv(T_odom_base_current)

and publishes that correction as TF plus a /map_to_odom TransformStamped topic
for nodes that need the numeric correction directly.
"""

import math

import rclpy
from geometry_msgs.msg import PoseWithCovarianceStamped, TransformStamped
from nav_msgs.msg import Odometry
from rclpy.node import Node
import tf2_ros


def _yaw_from_quat(q):
    return math.atan2(
        2.0 * (q.w * q.z + q.x * q.y),
        1.0 - 2.0 * (q.y * q.y + q.z * q.z),
    )


def _norm_angle(a):
    return math.atan2(math.sin(a), math.cos(a))


def _blend_angle(a, b, alpha):
    return _norm_angle(a + alpha * _norm_angle(b - a))


class ArucoMapOdom(Node):
    def __init__(self):
        super().__init__('aruco_map_odom')

        self.declare_parameter('odom_topic', '/odom')
        self.declare_parameter('aruco_pose_topic', '/aruco/pose')
        self.declare_parameter('map_to_odom_topic', '/map_to_odom')
        self.declare_parameter('map_frame', 'map')
        self.declare_parameter('odom_frame', 'odom')
        self.declare_parameter('base_frame', 'base_footprint')
        self.declare_parameter('publish_rate_hz', 20.0)
        self.declare_parameter('correction_alpha', 0.35)
        self.declare_parameter('max_correction_step_m', 0.20) #.15
        self.declare_parameter('max_correction_step_yaw', 0.70) 
        self.declare_parameter('max_odom_age', 0.30)
        self.declare_parameter('map_min_x', 0.0)
        self.declare_parameter('map_max_x', 3.76)
        self.declare_parameter('map_min_y', 0.0)
        self.declare_parameter('map_max_y', 4.86)
        self.declare_parameter('map_bounds_margin', 0.25)

        self._map_frame = self.get_parameter('map_frame').value
        self._odom_frame = self.get_parameter('odom_frame').value
        self._base_frame = self.get_parameter('base_frame').value
        self._alpha = float(self.get_parameter('correction_alpha').value)
        self._max_step_m = float(self.get_parameter('max_correction_step_m').value)
        self._max_step_yaw = float(self.get_parameter('max_correction_step_yaw').value)
        self._max_odom_age = float(self.get_parameter('max_odom_age').value)
        self._map_min_x = float(self.get_parameter('map_min_x').value)
        self._map_max_x = float(self.get_parameter('map_max_x').value)
        self._map_min_y = float(self.get_parameter('map_min_y').value)
        self._map_max_y = float(self.get_parameter('map_max_y').value)
        self._map_margin = float(self.get_parameter('map_bounds_margin').value)

        self._odom_pose = None
        self._odom_stamp = None
        self._x = 0.0
        self._y = 0.0
        self._yaw = 0.0
        self._initialized = False

        self._tf = tf2_ros.TransformBroadcaster(self)
        self._pub = self.create_publisher(
            TransformStamped,
            self.get_parameter('map_to_odom_topic').value,
            10,
        )

        self.create_subscription(
            Odometry,
            self.get_parameter('odom_topic').value,
            self._odom_cb,
            20,
        )
        self.create_subscription(
            PoseWithCovarianceStamped,
            self.get_parameter('aruco_pose_topic').value,
            self._aruco_cb,
            10,
        )

        rate = max(1.0, float(self.get_parameter('publish_rate_hz').value))
        self.create_timer(1.0 / rate, self._publish)

        self.get_logger().info(
            'aruco_map_odom ready: wheel odom owns odom->base, '
            'ArUco corrects map->odom')

    def _odom_cb(self, msg):
        q = msg.pose.pose.orientation
        self._odom_pose = (
            msg.pose.pose.position.x,
            msg.pose.pose.position.y,
            _yaw_from_quat(q),
        )
        self._odom_stamp = self.get_clock().now()

    def _aruco_cb(self, msg):
        if self._odom_pose is None or self._odom_stamp is None:
            self.get_logger().warn(
                'Ignoring ArUco correction: no /odom yet',
                throttle_duration_sec=2.0,
            )
            return

        odom_age = (self.get_clock().now() - self._odom_stamp).nanoseconds * 1e-9
        if odom_age > self._max_odom_age:
            self.get_logger().warn(
                f'Ignoring ArUco correction: odom age {odom_age:.2f}s',
                throttle_duration_sec=2.0,
            )
            return

        oq = msg.pose.pose.orientation
        map_base = (
            msg.pose.pose.position.x,
            msg.pose.pose.position.y,
            _yaw_from_quat(oq),
        )
        if not self._pose_inside_map(map_base):
            self.get_logger().warn(
                f'Rejected ArUco pose outside map bounds: '
                f'x={map_base[0]:.2f} y={map_base[1]:.2f} '
                f'yaw={math.degrees(map_base[2]):.1f}deg',
                throttle_duration_sec=1.0,
            )
            return

        odom_base = self._odom_pose

        yaw = _norm_angle(map_base[2] - odom_base[2])
        c = math.cos(yaw)
        s = math.sin(yaw)
        x = map_base[0] - (odom_base[0] * c - odom_base[1] * s)
        y = map_base[1] - (odom_base[0] * s + odom_base[1] * c)

        if not self._initialized:
            self._x = x
            self._y = y
            self._yaw = yaw
            self._initialized = True
            self.get_logger().info(
                f'Initial map->odom from ArUco: x={x:.3f} y={y:.3f} '
                f'yaw={math.degrees(yaw):.1f}deg')
            return

        step = math.hypot(x - self._x, y - self._y)
        yaw_step = abs(_norm_angle(yaw - self._yaw))
        if step > self._max_step_m or yaw_step > self._max_step_yaw:
            self.get_logger().warn(
                f'Rejected ArUco map->odom jump: dist={step:.2f}m '
                f'yaw={math.degrees(yaw_step):.1f}deg',
                throttle_duration_sec=2.0,
            )
            return

        a = min(1.0, max(0.0, self._alpha))
        self._x += a * (x - self._x)
        self._y += a * (y - self._y)
        self._yaw = _blend_angle(self._yaw, yaw, a)
        self.get_logger().info(
            f'ArUco map->odom: x={self._x:.3f} y={self._y:.3f} '
            f'yaw={math.degrees(self._yaw):.1f}deg | '
            f'map_base=({map_base[0]:.2f},{map_base[1]:.2f},'
            f'{math.degrees(map_base[2]):.1f}deg)',
            throttle_duration_sec=1.0,
        )

    def _pose_inside_map(self, pose):
        x, y, _ = pose
        margin = max(0.0, self._map_margin)
        return (
            self._map_min_x - margin <= x <= self._map_max_x + margin
            and self._map_min_y - margin <= y <= self._map_max_y + margin
        )

    def _publish(self):
        tf = TransformStamped()
        tf.header.stamp = self.get_clock().now().to_msg()
        tf.header.frame_id = self._map_frame
        tf.child_frame_id = self._odom_frame
        tf.transform.translation.x = self._x
        tf.transform.translation.y = self._y
        tf.transform.rotation.z = math.sin(self._yaw / 2.0)
        tf.transform.rotation.w = math.cos(self._yaw / 2.0)
        self._tf.sendTransform(tf)
        self._pub.publish(tf)


def main(args=None):
    rclpy.init(args=args)
    node = ArucoMapOdom()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
