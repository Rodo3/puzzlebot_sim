# WebSocket URL for the puzzlebot_web_bridge.
# Use ws://localhost:8000/ws when dashboard and bridge run on the same machine.
# Use ws://<BRIDGE_IP>:8000/ws when running on separate machines.
VITE_WS_URL=ws://localhost:8000/ws

# Environment indicator shown in the dashboard header.
# 'sim'  → blue [SIM]  badge  (Gazebo simulation)
# 'real' → green [REAL] badge (physical robot)
VITE_ROBOT_ENV=sim
